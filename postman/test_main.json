  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Set baseUrl if not defined",
          "const baseUrl = pm.collectionVariables.get('baseUrl') || 'http://localhost:8080';",
          "pm.collectionVariables.set('baseUrl', baseUrl);",
          "",
          "// Generate future date for event (now + 3 days)",
          "const moment = require('moment');",
          "const eventDate = moment().add(3, 'days').format('YYYY-MM-DD HH:mm:ss');",
          "pm.collectionVariables.set('eventDate', eventDate);",
          "",
          "// Unique values for email and category names",
          "const timestamp = Date.now();",
          "pm.collectionVariables.set('timestamp', timestamp);",
          "pm.collectionVariables.set('uniqueEmail1', `test.user+${timestamp}@example.com`);",
          "pm.collectionVariables.set('uniqueEmail2', `event.creator+${timestamp}@example.com`);",
          "pm.collectionVariables.set('uniqueEmail3', `second.user+${timestamp}@example.com`);",
          "pm.collectionVariables.set('uniqueCatName', `Concerts ${timestamp}`);",
          "pm.collectionVariables.set('uniqueCatName2', `Sports ${timestamp}`);"
        ],
        "type": "text/javascript"
      }
